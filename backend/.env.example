# LLM-Wiki — esempio di configurazione.
# Copia in backend/.env e compila i segreti. MAI committare il .env reale.
# backend/.gitignore lo esclude già: verifica con `git check-ignore backend/.env`.

# --- Server ---
HOST=0.0.0.0
PORT=8010
# Origini consentite (CORS). In produzione su subpath /dok/ aggiungi l'origine pubblica:
# ALLOWED_ORIGINS=https://migration.mikweb.eu,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3456,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:3456,http://127.0.0.1:8000,app://.

# --- IONOS AI Model Hub (LLM primario + embeddings) ---
IONOS_API_KEY=
IONOS_BASE_URL=https://openai.inference.de-txl.ionos.com/v1
IONOS_MODEL=meta-llama/Llama-3.3-70B-Instruct
# Modello embedding (verificato via GET /v1/models). BAAI/bge-m3 = 1024 dim.
IONOS_EMBED_MODEL=BAAI/bge-m3
# Vision per OCR ibrido
IONOS_VISION_MODEL=meta-llama/Llama-3.2-11B-Vision-Instruct

# --- Embeddings ---
# "ionos" (default quando IONOS_API_KEY è impostata) | "ollama" (legacy nomic-embed-text).
# ATTENZIONE: cambiare modello embedding richiede re-indicizzazione completa di Chroma
# (dimensioni vettore diverse) + rilancio scan su tutti i documenti.
EMBED_PROVIDER=ionos

# --- Ollama locale (fallback LLM; embedding solo se EMBED_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- OCR ibrido ---
OCR_HYBRID_ENABLED=1
OCR_MIN_CHARS_PER_PAGE=50

# --- HiDrive (OAuth2, STESSA app di Clumoove — vedi /opt/clumoove) ---
# client_id/secret già in produzione su Clumoove (docker-compose.yml):
# riusali qui, nessuna nuova registrazione su developer.hidrive.com.
# Il primo login (authorization_code -> refresh_token) si fa una tantum via
# GET /api/documents/hidrive/auth-url + POST /api/documents/hidrive/exchange;
# poi solo refresh automatico (60gg auto-extend).
HIDRIVE_CLIENT_ID=
HIDRIVE_CLIENT_SECRET=
HIDRIVE_REFRESH_TOKEN=
# Token condiviso da Clumoove (stesso metodo, zero nuovo login):
# se l'account HiDrive è collegato in Clumoove UI, llm-wiki lo riusa
# leggendo connection_profiles (sola lettura) e decifrando con la stessa
# chiave (AES-256-GCM, domain clumoove:oauth-*). Mai scritti log/secret.
CLUMOOVE_DB_URL=postgres://postgres:PASSWORD@postgres-db:5432/cloud_migration_db?sslmode=disable
CLUMOOVE_ENCRYPTION_KEY=
HIDRIVE_REDIRECT_URI=https://migration.mikweb.eu/api/oauth/callback
# "admin,rw" è UN singolo scope (stesso di Clumoove)
HIDRIVE_SCOPE=admin,rw
# Path HiDrive di default per lo scan (es. "/")
HIDRIVE_DEFAULT_PATH=/
# Auto-sync cartelle HiDrive (come scheduler Clumoove, tick 60s).
# 1 = attivo (default), 0 = solo sync manuale.
HIDRIVE_AUTO_SYNC=1
# Intervallo default per cartella in minuti (override per-cartella via
# PUT /api/hidrive/folders/{id} {"sync_interval_minutes": N}, min 5).
HIDRIVE_SYNC_INTERVAL_MINUTES=60
