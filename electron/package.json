{
  "name": "llm-wiki-desktop",
  "version": "1.0.0",
  "description": "LLM Wiki - AI Knowledge Base Desktop",
  "author": "LLM Wiki",
  "license": "MIT",
  "homepage": "https://github.com/Mikweb2025-design/LLM-Wiki",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "ELECTRON_START_URL=http://localhost:3000 electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.llmwiki.app",
    "productName": "LLM Wiki",
    "copyright": "Copyright © 2026 LLM Wiki",
    "protocols": [
      {
        "name": "LLM Wiki",
        "schemes": ["llm-wiki"]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "serve-build.js",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "minimumSystemVersion": "11.0",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "extraResources": [
      {
        "from": "../frontend-build",
        "to": "frontend-build"
      },
      {
        "from": "../backend/app",
        "to": "backend/app"
      },
      {
        "from": "../backend/requirements.txt",
        "to": "backend/requirements.txt"
      },
      {
        "from": "../backend/.env",
        "to": "backend/.env"
      }
    ],
    "asar": true
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  }
}
